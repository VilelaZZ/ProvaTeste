# Copie para ".env" (ou ".env.local") e ajuste. Reinicie o Expo depois: npx expo start -c
#
# 🔌 BACKEND: URL base da API Java (Spring Boot), SEM barra no final.
#
#  - Emulador Android .......: http://10.0.2.2:8080
#  - Simulador iOS / Web ....: http://localhost:8080
#  - Celular físico (Expo Go): http://<IP-DA-SUA-MAQUINA>:8080   (ex.: http://192.168.0.15:8080)
#    (celular e computador na mesma rede Wi-Fi; backend escutando em 0.0.0.0)
#
# Se o backend usa context-path, inclua: http://192.168.0.15:8080/api
EXPO_PUBLIC_API_URL=http://192.168.0.15:8080

# 🔌 Caminho do recurso de tarefas na API (padrão: /tarefas). Ex.: /api/tarefas
EXPO_PUBLIC_TASKS_PATH=/tarefas
